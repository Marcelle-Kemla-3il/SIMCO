# ─── SIMCO — .gitignore ───────────────────────────────────────────────────

# Environnements virtuels
simco_env/
venv/
env/
.venv/
ENV/

# Cache Python
__pycache__/
*.py[cod]
*.pyo
*.pyc
*$py.class

# Fichiers sensibles
backend/.env
services/quiz_backend/.env
services/notification_backend/.env
services/notification_backend/.env.local

# Dataset et modèles ML (trop lourds)
backend/data/training/*.jsonl
backend/data/training/*.csv
backend/data/models/*.pkl
backend/data/models/*.joblib
services/quiz_backend/data/training/*.jsonl
services/quiz_backend/data/models/*.pkl

# Images de debug
backend/debug_capture_*.jpg

# Anciens fichiers archivés
simco/
_archive_ssimco/

# Frontend
quiz-frontend/node_modules/
quiz-frontend/dist/
quiz-frontend/.env.local
quiz-frontend/.env.*.local
frontend/node_modules/
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Tests
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Distribution Python
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints

# mypy
.mypy_cache/
.dmypy.json

# Documentation
docs/_build/
/site